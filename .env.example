# URL du webhook Discord (obligatoire)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123456789012345678/your_webhook_token

# Fréquence de scan en secondes (180 = 3 minutes)
SCAN_INTERVAL_SECONDS=180

# Mots-clés séparés par des virgules.
# Exemple: velo,playstation,armoire
# Mettre * pour notifier toutes les annonces.
KEYWORDS=velo,playstation,armoire

# Zone de recherche (coordonnées GPS + rayon)
GEEV_LATITUDE=48.8566
GEEV_LONGITUDE=2.3522
GEEV_RADIUS_KM=20

# Limite de résultats demandés à Geev par scan
GEEV_PAGE_SIZE=40

# Endpoint Geev pour la récupération des annonces.
# Valeur par défaut utilisée par le script :
# https://mobile.geev.com/api/v2/search/items
# GEEV_API_URL=https://mobile.geev.com/api/v2/search/items

# Fichier JSON de persistance des annonces déjà notifiées
SEEN_STORAGE_PATH=data/seen_listings.json

# Activer le mode debug détaillé
DEBUG=false
